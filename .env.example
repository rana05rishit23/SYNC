# Copy to .env (never commit .env). Model ids verified against console.groq.com/docs/models (Nov 2026).
GROQ_API_KEY=your_key_here
ADVISOR_MODEL=openai/gpt-oss-120b        # alt: llama-3.3-70b-versatile (evaluate both on Hindi)
FAST_MODEL=openai/gpt-oss-20b
STT_MODEL=whisper-large-v3-turbo

# Reviewer-only endpoints (/api/kyc/review) stay closed unless this is set.
ADMIN_API_KEY=change-me
# Only needed if the frontend is hosted on a different origin (comma-separated).
# CORS_ORIGINS=https://your-frontend.example
